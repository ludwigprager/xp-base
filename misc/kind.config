# https://kind.sigs.k8s.io/docs/user/configuration/


# kind-cluster.yaml
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4

containerdConfigPatches:
  - |-
    [plugins."io.containerd.grpc.v1.cri".registry.mirrors."registry.g1"]
      endpoint = ["http://172.18.0.1:443"]

nodes:
  - role: control-plane
  - role: worker
#- role: worker
