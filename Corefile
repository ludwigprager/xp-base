.:53 {
    errors
    health {
       lameduck 5s
    }
    ready
hosts {
    172.18.0.1 registry.g1
    fallthrough
}

    kubernetes cluster.local in-addr.arpa ip6.arpa {
       pods insecure
       fallthrough in-addr.arpa ip6.arpa
       ttl 30
    }
    prometheus :9153
    forward . /etc/resolv.conf {
       max_concurrent 1000
    }
    cache 30
    loop
    reload
    loadbalance
}

